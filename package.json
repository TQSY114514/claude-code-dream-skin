{
  "name": "claude-code-dream-skin",
  "productName": "Claude Code Dream Skin",
  "version": "0.1.0",
  "description": "A safe, reversible theme enhancement tool for Claude Code Desktop",
  "author": "Claude Code Dream Skin Contributors",
  "license": "MIT",
  "homepage": "https://github.com/TQSY114514/claude-code-dream-skin",
  "repository": {
    "type": "git",
    "url": "https://github.com/TQSY114514/claude-code-dream-skin.git"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "electron",
    "theme",
    "skin",
    "cdp",
    "customization"
  ],
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "test": "node test/runner.js",
    "build-icon": "node tools/generate-icon.mjs",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis",
    "lint": "eslint src/",
    "pack": "electron-builder --dir",
    "dist": "npm run lint && npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "chrome-remote-interface": "^0.33.3",
    "electron-store": "^8.2.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.15.0"
  },
  "build": {
    "appId": "com.claudecodedreamskin.app",
    "productName": "Claude Code Dream Skin",
    "copyright": "Copyright 2025 Claude Code Dream Skin Contributors",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "src/**/*",
      "themes/**/*",
      "tools/**/*",
      "test/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Code Dream Skin",
      "perMachine": false
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/chrome-remote-interface/**/*"
    ]
  }
}
